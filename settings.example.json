{
  "template": "templates/electrician",
  "template_name": "Electrician \u00b7 English template",
  "template_edit_policy": "business-details-and-theme-only",
  "dashboard_port": 4310,
  "batch_size": 5,
  "requested_workers": 5,
  "vercel_scope": "<YOUR_VERCEL_SCOPE>",
  "vercel_cli": [
    "pnpm",
    "dlx",
    "vercel@59.16.0"
  ],
  "firecrawl_env_file": ".env",
  "max_scrape_pages_per_business": 5,
  "max_discovery_candidates": 20,
  "sender": {
    "name": "<YOUR_FULL_NAME>",
    "company": "<YOUR_COMPANY>",
    "phone": "<YOUR_PHONE>",
    "email": "<YOUR_EMAIL>",
    "first_name": "<YOUR_FIRST_NAME>",
    "last_name": "<YOUR_LAST_NAME>"
  },
  "outreach": {
    "submit_by_default": false,
    "include_preview_link": true,
    "language": "en",
    "offer": "Website is a one-time $500; the business also pays hosting costs (quoted by the operator on reply).",
    "skip_required_surname": false,
    "allow_inspection_forms": true,
    "skip_captchas": true,
    "complete_after_submit": true,
    "message_mode": "fixed",
    "website_price_usd": 500,
    "monthly_hosting_usd": 25
  },
  "worker_model": "gpt-5.6-terra",
  "worker_reasoning_effort": "low",
  "visible_worker_browsers": true,
  "build_mode": "quick-template",
  "default_template": "electrician",
  "templates": {
    "electrician": {
      "name": "Electrician \u00b7 base design",
      "path": "templates/electrician"
    }
  },
  "personalization_fields": [
    "name",
    "phone",
    "email",
    "street",
    "city",
    "zip",
    "theme_color"
  ],
  "scouting": {
    "screening_mode": "firecrawl-first",
    "initial_pages_per_business": 2,
    "max_concurrent_business_scrapes": 2,
    "visual_assessment": "agent-views-saved-screenshot",
    "final_form_check": "live-browser"
  },
  "trello": {
    "board_name": "<YOUR_TRELLO_BOARD>",
    "board_url": "",
    "lists": {
      "preview_sent": "Leads \u00b7 Preview Sent",
      "replied": "Leads \u00b7 Replied",
      "signed": "Leads \u00b7 Signed ($500)",
      "live": "Leads \u00b7 Live (Firebase)",
      "not_interested": "Leads \u00b7 Not Interested"
    },
    "follow_up_days": 5
  },
  "contracts": {
    "google_drive_leads_folder_id": "<LEADS_FOLDER_ID>",
    "proposal_template_doc_id": "<TEMPLATE_DOC_ID>",
    "placeholders": [
      "{{CLIENT_FULL_NAME}}",
      "{{CLIENT_FIRST_NAME}}",
      "{{BUSINESS_NAME}}",
      "{{MEETING_DATE}}"
    ]
  }
}
